---
import '../styles/global.css';
import BookingEstimator from '../components/BookingEstimator';
import MediaGallery, { type MediaItem } from '../components/MediaGallery';
import FloatingWhatsApp from '../components/FloatingWhatsApp';
import siteData from '../data/site.json';
import { rupiah, whatsappUrl } from '../data/contact';

export function getStaticPaths() {
  return Object.keys(siteData.pages).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const pageKey = slug as keyof typeof siteData.pages;
const page = siteData.pages[pageKey];
const canonical = `${siteData.seo.canonicalUrl.replace(/\/$/, '')}/${page.slug}/`;
const waLink = whatsappUrl(`Halo Alphard Elite, saya ingin reservasi ${page.badge}`);

const mediaItems: MediaItem[] = siteData.gallery.items.map((item) => ({
  ...item,
  type: item.type === 'video' ? 'video' : 'image',
  aspect: item.aspect === 'video' ? 'video' : item.aspect === 'vertical' ? 'vertical' : undefined,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.seoTitle,
  description: page.seoDescription,
  url: canonical,
  provider: {
    '@type': 'AutoRental',
    name: siteData.seo.brandName,
    telephone: `+${siteData.contact.whatsappNumber.replace(/^\+/, '')}`,
    image: new URL(siteData.seo.image, siteData.seo.canonicalUrl).toString(),
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteData.contact.officeAddress,
      addressLocality: siteData.seo.addressLocality,
      addressRegion: siteData.seo.addressRegion,
      postalCode: siteData.seo.postalCode,
      addressCountry: siteData.seo.addressCountry,
    },
  },
  areaServed: siteData.seo.areaServed,
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const pPrefix = `pages.${page.slug}`;
---

<!doctype html>
<html lang={siteData.seo.language}>
  <head>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-TP34JKNW"></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-16852131238"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-16852131238');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070708" />
    <title>{page.seoTitle}</title>
    <meta name="description" content={page.seoDescription} />
    <link rel="icon" href={siteData.seo.icon} sizes="any" />
    <link rel="icon" type="image/png" href={siteData.seo.pngIcon} />
    <link rel="apple-touch-icon" href={siteData.seo.appleTouchIcon} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={page.seoTitle} />
    <meta property="og:description" content={page.seoDescription} />
    <meta property="og:image" content={siteData.seo.image} />
    <meta property="og:locale" content={siteData.seo.locale} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preload" as="image" href={siteData.hero.carImage} fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/cormorant-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/outfit-var.woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </head>

  <body id="top" data-page-slug={page.slug}>
    <a href="#main" class="skip-link" data-cms="ui.skipLink">{siteData.ui.skipLink}</a>

    <header class="site-header">
      <div class="container-lux bar">
        <a href="/" aria-label={siteData.brand.homeLabel}>
          <img data-cms-src="brand.logo" data-cms-alt="brand.name" src={siteData.brand.logo} alt={siteData.brand.name} width="1000" height="208" class="h-8 sm:h-9 w-auto" />
        </a>
        <nav aria-label={siteData.ui.mainNavLabel} class="hidden lg:flex items-center gap-9">
          <a href="/">Beranda</a>
          <a href="#fasilitas">Fasilitas</a>
          <a href="#galeri">Galeri</a>
          <a href="#harga">Paket Wedding</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="flex items-center gap-4">
          <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost hidden sm:inline-flex !min-h-11 !py-2" data-cms="ui.bookingText">{siteData.ui.bookingText}</a>
          <details class="mobile-nav lg:hidden">
            <summary data-cms="ui.menuText">{siteData.ui.menuText}</summary>
            <nav aria-label={siteData.ui.mobileNavLabel}>
              <a href="/">Beranda</a>
              <a href="#fasilitas">Fasilitas</a>
              <a href="#galeri">Galeri</a>
              <a href="#harga">Paket Wedding</a>
              <a href="#faq">FAQ</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section id="hero-section" class="hero" aria-labelledby="hero-title">
        <div class="container-lux hero-grid">
          <div class="hero-copy">
            <p class="eyebrow" data-cms={`${pPrefix}.badge`}>{page.badge}</p>
            <h1 id="hero-title" class="display"><span data-cms={`${pPrefix}.title`}>{page.title}</span> <em data-cms={`${pPrefix}.titleEm`}>{page.titleEm}</em></h1>
            <p class="lead" data-cms={`${pPrefix}.lead`}>{page.lead}</p>
            <div class="hero-actions">
              <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal"><span data-cms={`${pPrefix}.buttonText`}>{page.buttonText}</span> <span aria-hidden="true">↗</span></a>
              <a href="#harga" class="link-lux" data-cms={`${pPrefix}.secondaryButtonText`}>{page.secondaryButtonText}</a>
            </div>
          </div>
          <figure class="hero-visual">
            <span class="hero-wordmark" aria-hidden="true" data-cms="brand.wordmark">{siteData.brand.wordmark}</span>
            <img data-cms-src="hero.carImage" data-cms-alt="hero.carAlt" src={siteData.hero.carImage} alt={siteData.hero.carAlt} width="1600" height="847" fetchpriority="high" decoding="async" />
            <figcaption><span data-cms="hero.carModel">{siteData.hero.carModel}</span><span data-cms="hero.carNote">{siteData.hero.carNote}</span></figcaption>
          </figure>
        </div>
        <div class="container-lux spec-bar" style={`grid-template-columns: repeat(${page.specBar.length}, 1fr)`}>
          {page.specBar.map((item, i) => (
            <p>
              <span data-cms={`${pPrefix}.specBar.${i}.label`}>{item.label}</span>
              <strong data-cms={`${pPrefix}.specBar.${i}.value`}>{item.value}</strong>
            </p>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="container-lux statement reveal">
          <h2 class="display"><span data-cms={`${pPrefix}.statementTitle`}>{page.statementTitle}</span> <em data-cms={`${pPrefix}.statementTitleEm`}>{page.statementTitleEm}</em></h2>
          <p class="lead" data-cms={`${pPrefix}.statementLead`}>{page.statementLead}</p>
        </div>
      </section>

      <section id="fasilitas" class="section section-alt" aria-labelledby="fasilitas-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms="facilities.badge">{siteData.facilities.badge}</p>
              <h2 id="fasilitas-title" class="display"><span data-cms="facilities.title">{siteData.facilities.title}</span> <em data-cms="facilities.titleEm">{siteData.facilities.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms="facilities.lead">{siteData.facilities.lead}</p>
          </div>
          <div class="pillars">
            {page.pillars.map((pillar, pIdx) => (
              <article class="pillar reveal">
                <div class="pillar-media">
                  <img data-cms-src={`${pPrefix}.pillars.${pIdx}.image`} data-cms-alt={`${pPrefix}.pillars.${pIdx}.alt`} src={pillar.image} alt={pillar.alt} width="1200" height="900" loading="lazy" decoding="async" />
                </div>
                <div>
                  <span class="pillar-numeral" aria-hidden="true" data-cms={`${pPrefix}.pillars.${pIdx}.numeral`}>{pillar.numeral}</span>
                  <p class="eyebrow mt-6" data-cms={`${pPrefix}.pillars.${pIdx}.eyebrow`}>{pillar.eyebrow}</p>
                  <h3 class="display" data-cms={`${pPrefix}.pillars.${pIdx}.title`}>{pillar.title}</h3>
                  <p class="lead" data-cms={`${pPrefix}.pillars.${pIdx}.lead`}>{pillar.lead}</p>
                  <ul>
                    {pillar.items.map((item, i) => (
                      <li><span>{String(i + 1).padStart(2, '0')}</span><div><strong data-cms={`${pPrefix}.pillars.${pIdx}.items.${i}.name`}>{item.name}</strong><p data-cms={`${pPrefix}.pillars.${pIdx}.items.${i}.desc`}>{item.desc}</p></div></li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="galeri" class="section" aria-labelledby="galeri-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms="gallery.badge">{siteData.gallery.badge}</p>
              <h2 id="galeri-title" class="display"><span data-cms="gallery.title">{siteData.gallery.title}</span> <em data-cms="gallery.titleEm">{siteData.gallery.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms="gallery.lead">{siteData.gallery.lead}</p>
          </div>
          <MediaGallery client:visible={{ rootMargin: '600px' }} items={mediaItems} labels={siteData.gallery.labels} />
        </div>
      </section>

      <section id="harga" class="section section-alt" aria-labelledby="harga-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms={`${pPrefix}.pricing.badge`}>{page.pricing.badge}</p>
              <h2 id="harga-title" class="display"><span data-cms={`${pPrefix}.pricing.title`}>{page.pricing.title}</span> <em data-cms={`${pPrefix}.pricing.titleEm`}>{page.pricing.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms={`${pPrefix}.pricing.lead`}>{page.pricing.lead}</p>
          </div>

          <div class="pricing">
            <article class="price-card reveal">
              <p class="eyebrow" data-cms={`${pPrefix}.pricing.pkg12.badge`}>{page.pricing.pkg12.badge}</p>
              <h3 class="display"><span data-cms={`${pPrefix}.pricing.pkg12.title`}>{page.pricing.pkg12.title}</span> <em data-cms={`${pPrefix}.pricing.pkg12.titleEm`}>{page.pricing.pkg12.titleEm}</em></h3>
              <p class="price" data-cms-rupiah={`${pPrefix}.pricing.pkg12.price`}>{rupiah(page.pricing.pkg12.price)}</p>
              <p class="price-was"><span data-cms={`${pPrefix}.pricing.normalLabel`}>{page.pricing.normalLabel}</span> <s data-cms-rupiah={`${pPrefix}.pricing.pkg12.normalPrice`}>{rupiah(page.pricing.pkg12.normalPrice)}</s></p>
              <ul id="pkg12-features">
                {page.pricing.pkg12.features.map((feature, i) => <li data-cms={`${pPrefix}.pricing.pkg12.features.${i}`}>{feature}</li>)}
              </ul>
              <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost" data-cms={`${pPrefix}.pricing.pkg12.buttonText`}>{page.pricing.pkg12.buttonText}</a>
            </article>

            <article class="price-card featured reveal">
              <p class="eyebrow" data-cms={`${pPrefix}.pricing.pkgAllDay.badge`}>{page.pricing.pkgAllDay.badge}</p>
              <h3 class="display"><span data-cms={`${pPrefix}.pricing.pkgAllDay.title`}>{page.pricing.pkgAllDay.title}</span> <em data-cms={`${pPrefix}.pricing.pkgAllDay.titleEm`}>{page.pricing.pkgAllDay.titleEm}</em></h3>
              <p class="price" data-cms-rupiah={`${pPrefix}.pricing.pkgAllDay.price`}>{rupiah(page.pricing.pkgAllDay.price)}</p>
              <p class="price-was"><span data-cms={`${pPrefix}.pricing.normalLabel`}>{page.pricing.normalLabel}</span> <s data-cms-rupiah={`${pPrefix}.pricing.pkgAllDay.normalPrice`}>{rupiah(page.pricing.pkgAllDay.normalPrice)}</s></p>
              <ul id="pkgAllDay-features">
                {page.pricing.pkgAllDay.features.map((feature, i) => <li data-cms={`${pPrefix}.pricing.pkgAllDay.features.${i}`}>{feature}</li>)}
              </ul>
              <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal" data-cms={`${pPrefix}.pricing.pkgAllDay.buttonText`}>{page.pricing.pkgAllDay.buttonText}</a>
            </article>
          </div>

          <BookingEstimator client:visible={{ rootMargin: '600px' }} />
        </div>
      </section>

      <section id="kebutuhan" class="section" aria-labelledby="kebutuhan-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms="segments.badge">{siteData.segments.badge}</p>
              <h2 id="kebutuhan-title" class="display"><span data-cms="segments.title">{siteData.segments.title}</span> <em data-cms="segments.titleEm">{siteData.segments.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms="segments.lead">{siteData.segments.lead}</p>
          </div>
          <ol class="segments">
            {siteData.segments.items.map((name, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p data-cms={`segments.items.${i}`}>{name}</p></li>)}
          </ol>
        </div>
      </section>

      <section id="faq" class="section section-alt" aria-labelledby="faq-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms={`${pPrefix}.faqBadge`}>{page.faqBadge}</p>
              <h2 id="faq-title" class="display"><span data-cms={`${pPrefix}.faqTitle`}>{page.faqTitle}</span> <em data-cms={`${pPrefix}.faqTitleEm`}>{page.faqTitleEm}</em></h2>
            </div>
            <p class="lead" data-cms={`${pPrefix}.faqLead`}>{page.faqLead}</p>
          </div>
          <div id="page-faq-list" class="faq-list">
            {page.faqs.map((item, i) => (
              <details class="faq-item reveal" open={i === 0}>
                <summary data-cms={`${pPrefix}.faqs.${i}.q`}>{item.q}</summary>
                <p data-cms={`${pPrefix}.faqs.${i}.a`}>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section closing" aria-labelledby="closing-title">
        <img data-cms-src="closing.image" src={siteData.closing.image} alt="" width="1200" height="900" loading="lazy" decoding="async" />
        <div class="container-lux reveal">
          <p class="eyebrow" data-cms="closing.badge">{siteData.closing.badge}</p>
          <h2 id="closing-title" class="display mt-6"><span data-cms="closing.title">{siteData.closing.title}</span> <em data-cms="closing.titleEm">{siteData.closing.titleEm}</em></h2>
          <p class="lead mx-auto mt-6" data-cms={`${pPrefix}.closingLead`}>{page.closingLead}</p>
          <div class="mt-10 flex justify-center">
            <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal"><span data-cms="closing.buttonText">{siteData.closing.buttonText}</span> <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer id="kontak" class="site-footer">
      <div class="container-lux">
        <div class="footer-grid">
          <div>
            <img data-cms-src="brand.logo" data-cms-alt="brand.name" src={siteData.brand.logo} alt={siteData.brand.name} width="1000" height="208" loading="lazy" class="h-9 w-auto mb-5" />
            <p class="max-w-sm" data-cms="footer.description">{siteData.footer.description}</p>
          </div>
          <div>
            <h4 data-cms="footer.officeLabel">{siteData.footer.officeLabel}</h4>
            <address class="not-italic">
              <strong data-cms="contact.officeName">{siteData.contact.officeName}</strong><br />
              <span data-cms="contact.officeAddress">{siteData.contact.officeAddress}</span>
            </address>
          </div>
          <div>
            <h4 data-cms="footer.serviceLabel">{siteData.footer.serviceLabel}</h4>
            <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="link-lux text-xl" data-cms="contact.whatsappDisplay">{siteData.contact.whatsappDisplay}</a>
            <p class="mt-3" data-cms="footer.serviceNote">{siteData.footer.serviceNote}</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row flex-wrap justify-between gap-4 pt-8 text-xs">
          <p data-cms="contact.copyright">{siteData.contact.copyright}</p>
          <div class="flex flex-wrap gap-6"><a href="/">Beranda</a><a href="/wedding-car-bandung/">Wedding Car Bandung</a><a href="/mobil-pengantin-bandung/">Mobil Pengantin Bandung</a><a href="#top" class="link-lux" data-cms="footer.backToTopText">{siteData.footer.backToTopText}</a></div>
        </div>
      </div>
    </footer>

    <FloatingWhatsApp />
    <script>
      const formatRp = (n: number) => `Rp ${Number(n || 0).toLocaleString('id-ID')}`;
      const getPath = (obj: unknown, path: string): unknown =>
        path.split('.').reduce((acc: unknown, k) => (acc && typeof acc === 'object' ? (acc as Record<string, unknown>)[k] : undefined), obj);

      window.addEventListener('message', (event) => {
        const msg = event.data;
        if (!msg || typeof msg !== 'object') return;
        if (msg.type !== 'cms:update' || !msg.siteData) return;
        const d = msg.siteData;
        const slug = document.body.dataset.pageSlug || '';
        const p = d.pages?.[slug];
        if (p?.seoTitle) document.title = p.seoTitle;

        document.querySelectorAll<HTMLElement>('[data-cms]').forEach((el) => {
          const val = getPath(d, el.dataset.cms || '');
          if (val !== undefined && typeof val !== 'object') el.textContent = String(val);
        });
        document.querySelectorAll<HTMLElement>('[data-cms-rupiah]').forEach((el) => {
          const val = getPath(d, el.dataset.cmsRupiah || '');
          if (val !== undefined) el.textContent = formatRp(Number(val));
        });
        document.querySelectorAll<HTMLImageElement>('[data-cms-src]').forEach((el) => {
          const val = getPath(d, el.dataset.cmsSrc || '');
          if (typeof val === 'string' && el.getAttribute('src') !== val) el.src = val;
        });

        const renderFeatureList = (sel: string, items: string[]) => {
          const ul = document.querySelector(sel);
          if (!ul || !Array.isArray(items)) return;
          ul.innerHTML = '';
          items.forEach((txt) => {
            const li = document.createElement('li');
            li.textContent = txt;
            ul.appendChild(li);
          });
        };
        renderFeatureList('#pkg12-features', p?.pricing?.pkg12?.features);
        renderFeatureList('#pkgAllDay-features', p?.pricing?.pkgAllDay?.features);

        if (Array.isArray(p?.faqs)) {
          const faqWrap = document.querySelector('#page-faq-list');
          if (faqWrap) {
            faqWrap.innerHTML = '';
            p.faqs.forEach((item: { q: string; a: string }, i: number) => {
              const det = document.createElement('details');
              det.className = 'faq-item';
              if (i === 0) det.open = true;
              const sum = document.createElement('summary');
              sum.textContent = item.q;
              const par = document.createElement('p');
              par.textContent = item.a;
              det.append(sum, par);
              faqWrap.appendChild(det);
            });
          }
        }
      });
    </script>
  </body>
</html>
