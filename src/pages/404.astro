---
import '../styles/global.css';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Halaman tidak ditemukan | Alphard Elite</title>
    <link rel="icon" type="image/png" href="/assets/logo.png" />
  </head>
  <body>
    <main class="container-lux min-h-dvh flex flex-col justify-center py-24">
      <a href="/" class="inline-block mb-16"><img src="/assets/logo.webp" width="1000" height="208" class="h-9 w-auto" alt="Alphard Elite — beranda" /></a>
      <p class="eyebrow">404 · Halaman tidak ditemukan</p>
      <h1 class="display text-5xl sm:text-7xl my-8">Mari kembali <em>ke rute yang tepat.</em></h1>
      <p class="lead mb-10">Alamat ini tidak tersedia. Lihat fasilitas, tarif, dan reservasi Alphard Elite di halaman utama.</p>
      <a href="/" class="btn-metal self-start">Kembali ke beranda <span aria-hidden="true">→</span></a>
    </main>
  </body>
</html>
