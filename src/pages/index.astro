const segments = [
  'Penjemputan VIP/VVIP', 'Pejabat & Tokoh Publik', 'Kunjungan Diplomatik',
  'Delegasi & Tamu VIP', 'Acara Perusahaan & Kenegaraan', 'Perjalanan Bisnis & Dinas',
