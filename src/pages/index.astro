---
import '../styles/global.css';
import BookingEstimator from '../components/BookingEstimator';
import MediaGallery, { type MediaItem } from '../components/MediaGallery';
import FloatingWhatsApp from '../components/FloatingWhatsApp';
import siteData from '../data/site.json';
import { rupiah, whatsappUrl } from '../data/contact';

const waLink = whatsappUrl();
const mediaItems: MediaItem[] = siteData.gallery.items.map((item) => ({
  ...item,
  type: item.type === 'video' ? 'video' : 'image',
  aspect: item.aspect === 'video' ? 'video' : item.aspect === 'vertical' ? 'vertical' : undefined,
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRental',
  name: siteData.seo.brandName,
  description: siteData.seo.description,
  image: new URL(siteData.seo.image, siteData.seo.canonicalUrl).toString(),
  telephone: `+${siteData.contact.whatsappNumber.replace(/^\+/, '')}`,
  areaServed: siteData.seo.areaServed,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteData.contact.officeAddress,
    addressLocality: siteData.seo.addressLocality,
    addressRegion: siteData.seo.addressRegion,
    postalCode: siteData.seo.postalCode,
    addressCountry: siteData.seo.addressCountry,
  },
  priceRange: siteData.seo.priceRange,
};
---

<!doctype html>
<html lang={siteData.seo.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070708" />
    <title>{siteData.seo.title}</title>
    <meta name="description" content={siteData.seo.description} />
    <link rel="icon" href={siteData.seo.icon} sizes="any" />
    <link rel="icon" type="image/png" href={siteData.seo.pngIcon} />
    <link rel="apple-touch-icon" href={siteData.seo.appleTouchIcon} />
    <link rel="canonical" href={siteData.seo.canonicalUrl} />
    <meta property="og:title" content={siteData.seo.title} />
    <meta property="og:description" content={siteData.seo.description} />
    <meta property="og:image" content={siteData.seo.image} />
    <meta property="og:locale" content={siteData.seo.locale} />
    <meta property="og:type" content="website" />
    <link rel="preload" as="image" href={siteData.hero.carImage} fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/cormorant-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/outfit-var.woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body id="top">
    <a href="#main" class="skip-link" data-cms="ui.skipLink">{siteData.ui.skipLink}</a>

    <header class="site-header" data-cms-section="brand,ui,nav">
      <div class="container-lux bar">
        <a href="#top" aria-label={siteData.brand.homeLabel}>
          <img data-cms-src="brand.logo" data-cms-alt="brand.name" src={siteData.brand.logo} alt={siteData.brand.name} width="1000" height="208" class="h-8 sm:h-9 w-auto" />
        </a>
        <nav id="desktop-nav" aria-label={siteData.ui.mainNavLabel} class="hidden lg:flex items-center gap-9">
          {siteData.nav.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
        <div class="flex items-center gap-4">
          <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost hidden sm:inline-flex !min-h-11 !py-2" data-cms="ui.bookingText">{siteData.ui.bookingText}</a>
          <details class="mobile-nav lg:hidden">
            <summary data-cms="ui.menuText">{siteData.ui.menuText}</summary>
            <nav id="mobile-nav-list" aria-label={siteData.ui.mobileNavLabel}>
              {siteData.nav.map(({ href, label }) => <a href={href}>{label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section id="hero-section" data-cms-section="hero" class="hero" aria-labelledby="hero-title">
        <div class="container-lux hero-grid">
          <div class="hero-copy">
            <p class="eyebrow" data-cms="hero.badge">{siteData.hero.badge}</p>
            <h1 id="hero-title" class="display"><span data-cms="hero.title">{siteData.hero.title}</span> <em data-cms="hero.titleEm">{siteData.hero.titleEm}</em></h1>
            <p class="lead" data-cms="hero.lead">{siteData.hero.lead}</p>
            <div class="hero-actions">
              <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal"><span data-cms="hero.buttonText">{siteData.hero.buttonText}</span> <span aria-hidden="true">↗</span></a>
              <a href="#harga" class="link-lux" data-cms="hero.secondaryButtonText">{siteData.hero.secondaryButtonText}</a>
            </div>
          </div>
          <figure class="hero-visual">
            <span class="hero-wordmark" aria-hidden="true" data-cms="brand.wordmark">{siteData.brand.wordmark}</span>
            <img data-cms-src="hero.carImage" data-cms-alt="hero.carAlt" src={siteData.hero.carImage} alt={siteData.hero.carAlt} width="1600" height="847" fetchpriority="high" decoding="async" />
            <figcaption><span data-cms="hero.carModel">{siteData.hero.carModel}</span><span data-cms="hero.carNote">{siteData.hero.carNote}</span></figcaption>
          </figure>
        </div>
        <div id="spec-bar" class="container-lux spec-bar">
          <p><span data-cms="hero.specBar.dropOffLabel">{siteData.hero.specBar.dropOffLabel}</span><strong data-cms-rupiah="pricing.dropOff.price">{rupiah(siteData.pricing.dropOff.price)}</strong></p>
          <p><span data-cms="hero.specBar.harianLabel">{siteData.hero.specBar.harianLabel}</span><strong data-cms-rupiah="pricing.harian.price">{rupiah(siteData.pricing.harian.price)}</strong></p>
          {siteData.hero.specBar.items.map((item, i) => <p><span data-cms={`hero.specBar.items.${i}.label`}>{item.label}</span><strong data-cms={`hero.specBar.items.${i}.value`}>{item.value}</strong></p>)}
        </div>
      </section>

      <section id="statement-section" data-cms-section="statement" class="section">
        <div class="container-lux statement reveal">
          <h2 class="display"><span data-cms="statement.title">{siteData.statement.title}</span> <em data-cms="statement.titleEm">{siteData.statement.titleEm}</em></h2>
          <p class="lead" data-cms="statement.lead">{siteData.statement.lead}</p>
        </div>
      </section>

      <section id="fasilitas" data-cms-section="facilities" class="section section-alt" aria-labelledby="fasilitas-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms="facilities.badge">{siteData.facilities.badge}</p>
              <h2 id="fasilitas-title" class="display"><span data-cms="facilities.title">{siteData.facilities.title}</span> <em data-cms="facilities.titleEm">{siteData.facilities.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms="facilities.lead">{siteData.facilities.lead}</p>
          </div>
          <div id="pillars-list" class="pillars">
            {siteData.facilities.pillars.map((pillar, pIdx) => (
              <article class="pillar reveal">
                <div class="pillar-media">
                  <img data-cms-src={`facilities.pillars.${pIdx}.image`} data-cms-alt={`facilities.pillars.${pIdx}.alt`} src={pillar.image} alt={pillar.alt} width="1200" height="900" loading="lazy" decoding="async" />
                </div>
                <div>
                  <span class="pillar-numeral" aria-hidden="true" data-cms={`facilities.pillars.${pIdx}.numeral`}>{pillar.numeral}</span>
                  <p class="eyebrow mt-6" data-cms={`facilities.pillars.${pIdx}.eyebrow`}>{pillar.eyebrow}</p>
                  <h3 class="display" data-cms={`facilities.pillars.${pIdx}.title`}>{pillar.title}</h3>
                  <p class="lead" data-cms={`facilities.pillars.${pIdx}.lead`}>{pillar.lead}</p>
                  <ul>
                    {pillar.items.map((item, i) => (
                      <li><span>{String(i + 1).padStart(2, '0')}</span><div><strong data-cms={`facilities.pillars.${pIdx}.items.${i}.name`}>{item.name}</strong><p data-cms={`facilities.pillars.${pIdx}.items.${i}.desc`}>{item.desc}</p></div></li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="galeri" data-cms-section="gallery" class="section" aria-labelledby="galeri-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms="gallery.badge">{siteData.gallery.badge}</p>
              <h2 id="galeri-title" class="display"><span data-cms="gallery.title">{siteData.gallery.title}</span> <em data-cms="gallery.titleEm">{siteData.gallery.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms="gallery.lead">{siteData.gallery.lead}</p>
          </div>
          <MediaGallery client:visible={{ rootMargin: '600px' }} items={mediaItems} labels={siteData.gallery.labels} />
        </div>
      </section>

      <section id="harga" data-cms-section="pricing" class="section section-alt" aria-labelledby="harga-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms="pricing.badge">{siteData.pricing.badge}</p>
              <h2 id="harga-title" class="display"><span data-cms="pricing.title">{siteData.pricing.title}</span> <em data-cms="pricing.titleEm">{siteData.pricing.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms="pricing.lead">{siteData.pricing.lead}</p>
          </div>

          <div class="pricing">
            <article class="price-card reveal">
              <p class="eyebrow" data-cms="pricing.dropOff.badge">{siteData.pricing.dropOff.badge}</p>
              <h3 class="display"><span data-cms="pricing.dropOff.title">{siteData.pricing.dropOff.title}</span> <em data-cms="pricing.dropOff.titleEm">{siteData.pricing.dropOff.titleEm}</em></h3>
              <p class="price" data-cms-rupiah="pricing.dropOff.price">{rupiah(siteData.pricing.dropOff.price)}</p>
              <p class="price-was"><span data-cms="pricing.normalLabel">{siteData.pricing.normalLabel}</span> <s data-cms-rupiah="pricing.dropOff.normalPrice">{rupiah(siteData.pricing.dropOff.normalPrice)}</s></p>
              <ul id="dropoff-features">
                {siteData.pricing.dropOff.features.map((feature, i) => <li data-cms={`pricing.dropOff.features.${i}`}>{feature}</li>)}
              </ul>
              <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost" data-cms="pricing.dropOff.buttonText">{siteData.pricing.dropOff.buttonText}</a>
            </article>

            <article class="price-card featured reveal">
              <p class="eyebrow" data-cms="pricing.harian.badge">{siteData.pricing.harian.badge}</p>
              <h3 class="display"><span data-cms="pricing.harian.title">{siteData.pricing.harian.title}</span> <em data-cms="pricing.harian.titleEm">{siteData.pricing.harian.titleEm}</em></h3>
              <p class="price" data-cms-rupiah="pricing.harian.price">{rupiah(siteData.pricing.harian.price)}</p>
              <p class="price-was"><span data-cms="pricing.normalLabel">{siteData.pricing.normalLabel}</span> <s data-cms-rupiah="pricing.harian.normalPrice">{rupiah(siteData.pricing.harian.normalPrice)}</s></p>
              <ul id="harian-features">
                {siteData.pricing.harian.features.map((feature, i) => <li data-cms={`pricing.harian.features.${i}`}>{feature}</li>)}
              </ul>
              <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal" data-cms="pricing.harian.buttonText">{siteData.pricing.harian.buttonText}</a>
            </article>
          </div>

          <BookingEstimator client:visible={{ rootMargin: '600px' }} />
        </div>
      </section>

      <section id="kebutuhan" data-cms-section="segments" class="section" aria-labelledby="kebutuhan-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow" data-cms="segments.badge">{siteData.segments.badge}</p>
              <h2 id="kebutuhan-title" class="display"><span data-cms="segments.title">{siteData.segments.title}</span> <em data-cms="segments.titleEm">{siteData.segments.titleEm}</em></h2>
            </div>
            <p class="lead" data-cms="segments.lead">{siteData.segments.lead}</p>
          </div>
          <ol id="segments-list" class="segments">
            {siteData.segments.items.map((name, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p data-cms={`segments.items.${i}`}>{name}</p></li>)}
          </ol>
        </div>
      </section>

      <section id="closing-section" data-cms-section="closing" class="section closing" aria-labelledby="closing-title">
        <img data-cms-src="closing.image" src={siteData.closing.image} alt="" width="1200" height="900" loading="lazy" decoding="async" />
        <div class="container-lux reveal">
          <p class="eyebrow" data-cms="closing.badge">{siteData.closing.badge}</p>
          <h2 id="closing-title" class="display mt-6"><span data-cms="closing.title">{siteData.closing.title}</span> <em data-cms="closing.titleEm">{siteData.closing.titleEm}</em></h2>
          <p class="lead mx-auto mt-6" data-cms="closing.lead">{siteData.closing.lead}</p>
          <div class="mt-10 flex justify-center">
            <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal"><span data-cms="closing.buttonText">{siteData.closing.buttonText}</span> <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer id="kontak" data-cms-section="contact,footer,legal" class="site-footer">
      <div class="container-lux">
        <div class="footer-grid">
          <div>
            <img data-cms-src="brand.logo" data-cms-alt="brand.name" src={siteData.brand.logo} alt={siteData.brand.name} width="1000" height="208" loading="lazy" class="h-9 w-auto mb-5" />
            <p class="max-w-sm" data-cms="footer.description">{siteData.footer.description}</p>
          </div>
          <div>
            <h4 data-cms="footer.officeLabel">{siteData.footer.officeLabel}</h4>
            <address class="not-italic">
              <strong data-cms="contact.officeName">{siteData.contact.officeName}</strong><br />
              <span data-cms="contact.officeAddress">{siteData.contact.officeAddress}</span>
            </address>
          </div>
          <div>
            <h4 data-cms="footer.serviceLabel">{siteData.footer.serviceLabel}</h4>
            <a data-wa-link href={waLink} target="_blank" rel="noopener noreferrer" class="link-lux text-xl" data-cms="contact.whatsappDisplay">{siteData.contact.whatsappDisplay}</a>
            <p class="mt-3" data-cms="footer.serviceNote">{siteData.footer.serviceNote}</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row flex-wrap justify-between gap-4 pt-8 text-xs">
          <p data-cms="contact.copyright">{siteData.contact.copyright}</p>
          <div class="flex flex-wrap gap-6"><a href="#privasi" class="link-lux" data-cms="legal.privacyTitle">{siteData.legal.privacyTitle}</a><a href="#ketentuan" class="link-lux" data-cms="legal.termsTitle">{siteData.legal.termsTitle}</a><a href="#top" class="link-lux" data-cms="footer.backToTopText">{siteData.footer.backToTopText}</a></div>
        </div>
        <div class="legal-notes">
          <section id="privasi"><h3 data-cms="legal.privacyTitle">{siteData.legal.privacyTitle}</h3><p><span data-cms="legal.privacyText">{siteData.legal.privacyText}</span> <a data-cms-href="legal.privacyLinkUrl" href={siteData.legal.privacyLinkUrl} target="_blank" rel="noopener noreferrer" data-cms="legal.privacyLinkText">{siteData.legal.privacyLinkText}</a>.</p></section>
          <section id="ketentuan"><h3 data-cms="legal.termsTitle">{siteData.legal.termsTitle}</h3><p data-cms="legal.termsText">{siteData.legal.termsText}</p></section>
        </div>
      </div>
    </footer>

    <FloatingWhatsApp />
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      menu?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) menu.open = false;
      });
      menu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      const links = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a');
      const observer = new IntersectionObserver((entries) => {
        const current = entries.find((entry) => entry.isIntersecting);
        if (!current) return;
        for (const link of links) {
          if (link.hash === `#${current.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      }, { rootMargin: '-15% 0px -60% 0px' });
      document.querySelectorAll('main section[id], footer[id]').forEach((section) => observer.observe(section));

      const formatRp = (n: number) => `Rp ${Number(n || 0).toLocaleString('id-ID')}`;
      const getPath = (obj: unknown, path: string): unknown =>
        path.split('.').reduce((acc: unknown, k) => (acc && typeof acc === 'object' ? (acc as Record<string, unknown>)[k] : undefined), obj);

      const sectionTargets: Record<string, string> = {
        contact: '#kontak',
        pricing: '#harga',
        hero: '#hero-section',
        statement: '#statement-section',
        facilities: '#fasilitas',
        gallery: '#galeri',
        segments: '#kebutuhan',
        booking: '#reservasi',
        closing: '#closing-section',
        footer: '#kontak',
        legal: '#privasi',
        seo: '#top',
        brand: '#top',
        ui: '#top',
        nav: '#top',
      };

      window.addEventListener('message', (event) => {
        const msg = event.data;
        if (!msg || typeof msg !== 'object') return;
        if (msg.type === 'cms:scroll' && typeof msg.section === 'string') {
          const sel = sectionTargets[msg.section];
          const target = sel ? document.querySelector(sel) : null;
          target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
        if (msg.type !== 'cms:update' || !msg.siteData) return;
        const d = msg.siteData;
        if (d.seo?.title) document.title = d.seo.title;

        document.querySelectorAll<HTMLElement>('[data-cms]').forEach((el) => {
          const val = getPath(d, el.dataset.cms || '');
          if (val !== undefined && typeof val !== 'object') el.textContent = String(val);
        });
        document.querySelectorAll<HTMLElement>('[data-cms-rupiah]').forEach((el) => {
          const val = getPath(d, el.dataset.cmsRupiah || '');
          if (val !== undefined) el.textContent = formatRp(Number(val));
        });
        document.querySelectorAll<HTMLImageElement>('[data-cms-src]').forEach((el) => {
          const val = getPath(d, el.dataset.cmsSrc || '');
          if (typeof val === 'string' && el.getAttribute('src') !== val) el.src = val;
        });
        document.querySelectorAll<HTMLImageElement>('[data-cms-alt]').forEach((el) => {
          const val = getPath(d, el.dataset.cmsAlt || '');
          if (typeof val === 'string') el.alt = val;
        });
        document.querySelectorAll<HTMLAnchorElement>('[data-cms-href]').forEach((el) => {
          const val = getPath(d, el.dataset.cmsHref || '');
          if (typeof val === 'string') el.href = val;
        });

        if (d.contact?.whatsappNumber) {
          const wa = `https://wa.me/${d.contact.whatsappNumber}?text=${encodeURIComponent(d.contact.defaultMessage || '')}`;
          document.querySelectorAll<HTMLAnchorElement>('[data-wa-link], a[href*="wa.me"]').forEach((a) => {
            a.href = wa;
          });
        }

        if (Array.isArray(d.nav)) {
          ['#desktop-nav', '#mobile-nav-list'].forEach((sel) => {
            const navEl = document.querySelector(sel);
            if (!navEl) return;
            navEl.innerHTML = '';
            d.nav.forEach((item: { href: string; label: string }) => {
              const a = document.createElement('a');
              a.href = item.href;
              a.textContent = item.label;
              navEl.appendChild(a);
            });
          });
        }

        const renderFeatureList = (sel: string, items: string[]) => {
          const ul = document.querySelector(sel);
          if (!ul || !Array.isArray(items)) return;
          ul.innerHTML = '';
          items.forEach((txt) => {
            const li = document.createElement('li');
            li.textContent = txt;
            ul.appendChild(li);
          });
        };
        renderFeatureList('#dropoff-features', d.pricing?.dropOff?.features);
        renderFeatureList('#harian-features', d.pricing?.harian?.features);

        if (Array.isArray(d.segments?.items)) {
          const ol = document.querySelector('#segments-list');
          if (ol) {
            ol.innerHTML = '';
            d.segments.items.forEach((name: string, i: number) => {
              const li = document.createElement('li');
              const span = document.createElement('span');
              span.textContent = String(i + 1).padStart(2, '0');
              const p = document.createElement('p');
              p.textContent = name;
              li.append(span, p);
              ol.appendChild(li);
            });
          }
        }
      });
    </script>
  </body>
</html>
