      ['Free Earphones for 2nd-Row', 'Pengalaman hiburan yang lebih privat.'],
    ],
  },
  {
    numeral: 'III',
    eyebrow: 'Business Services',
    title: 'Ruang kerja yang ikut bergerak.',
    lead: 'Tetap produktif dengan fasilitas yang mendukung mobilitas bisnis Anda.',
    image: '/assets/foto/wireless-presentation-screen.webp',
    alt: 'Layar presentasi nirkabel di dalam kabin Alphard',
    items: [
      ['Unlimited High-Speed Wi-Fi', 'Internet cepat tanpa batas selama perjalanan.'],
      ['Wireless Presentation Screen', 'Presentasi nirkabel untuk keperluan bisnis.'],
