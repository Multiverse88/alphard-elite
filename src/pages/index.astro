    type: 'image',
    title: 'Healthy & Nutritious Snacks',
    subtitle: 'Camilan sehat yang lezat dan bergizi untuk menemani perjalanan.',
    src: '/assets/foto/healthy--nutritious-snacks.webp',
  },
  {
    id: 'foto-equil',
    type: 'image',
    title: 'Equil Mineral Water',
    subtitle: 'Air mineral premium berkualitas tinggi di setiap perjalanan.',
    src: '/assets/foto/equil-mineral-water.webp',
  },
  {
    id: 'foto-netflix',
    type: 'image',
    title: 'Netflix & YouTube Premium',
