---
import '../styles/global.css';
import BookingEstimator from '../components/BookingEstimator';
import MediaGallery, { type MediaItem } from '../components/MediaGallery';
import FloatingWhatsApp from '../components/FloatingWhatsApp';
import siteData from '../data/site.json';
import { rupiah, whatsappUrl } from '../data/contact';

const waLink = whatsappUrl();
const mediaItems: MediaItem[] = siteData.gallery.items.map((item) => ({
  ...item,
  type: item.type === 'video' ? 'video' : 'image',
  aspect: item.aspect === 'video' ? 'video' : item.aspect === 'vertical' ? 'vertical' : undefined,
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRental',
  name: siteData.seo.brandName,
  description: siteData.seo.description,
  image: new URL(siteData.seo.image, siteData.seo.canonicalUrl).toString(),
  telephone: `+${siteData.contact.whatsappNumber.replace(/^\+/, '')}`,
  areaServed: siteData.seo.areaServed,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteData.contact.officeAddress,
    addressLocality: siteData.seo.addressLocality,
    addressRegion: siteData.seo.addressRegion,
    postalCode: siteData.seo.postalCode,
    addressCountry: siteData.seo.addressCountry,
  },
  priceRange: siteData.seo.priceRange,
};
---

<!doctype html>
<html lang={siteData.seo.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070708" />
    <title>{siteData.seo.title}</title>
    <meta name="description" content={siteData.seo.description} />
    <link rel="icon" href={siteData.seo.icon} sizes="any" />
    <link rel="icon" type="image/png" href={siteData.seo.pngIcon} />
    <link rel="apple-touch-icon" href={siteData.seo.appleTouchIcon} />
    <link rel="canonical" href={siteData.seo.canonicalUrl} />
    <meta property="og:title" content={siteData.seo.title} />
    <meta property="og:description" content={siteData.seo.description} />
    <meta property="og:image" content={siteData.seo.image} />
    <meta property="og:locale" content={siteData.seo.locale} />
    <meta property="og:type" content="website" />
    <link rel="preload" as="image" href={siteData.hero.carImage} fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/cormorant-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/outfit-var.woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body id="top">
    <a href="#main" class="skip-link">{siteData.ui.skipLink}</a>

    <header class="site-header">
      <div class="container-lux bar">
        <a href="#top" aria-label={siteData.brand.homeLabel}>
          <img src={siteData.brand.logo} alt={siteData.brand.name} width="1000" height="208" class="h-8 sm:h-9 w-auto" />
        </a>
        <nav aria-label={siteData.ui.mainNavLabel} class="hidden lg:flex items-center gap-9">
          {siteData.nav.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
        <div class="flex items-center gap-4">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost hidden sm:inline-flex !min-h-11 !py-2">{siteData.ui.bookingText}</a>
          <details class="mobile-nav lg:hidden">
            <summary>{siteData.ui.menuText}</summary>
            <nav aria-label={siteData.ui.mobileNavLabel}>
              {siteData.nav.map(({ href, label }) => <a href={href}>{label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container-lux hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">{siteData.hero.badge}</p>
            <h1 id="hero-title" class="display">{siteData.hero.title} <em>{siteData.hero.titleEm}</em></h1>
            <p class="lead">{siteData.hero.lead}</p>
            <div class="hero-actions">
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal">{siteData.hero.buttonText} <span aria-hidden="true">↗</span></a>
              <a href="#harga" class="link-lux">{siteData.hero.secondaryButtonText}</a>
            </div>
          </div>
          <figure class="hero-visual">
            <span class="hero-wordmark" aria-hidden="true">{siteData.brand.wordmark}</span>
            <img src={siteData.hero.carImage} alt={siteData.hero.carAlt} width="1600" height="847" fetchpriority="high" decoding="async" />
            <figcaption><span>{siteData.hero.carModel}</span><span>{siteData.hero.carNote}</span></figcaption>
          </figure>
        </div>
        <div class="container-lux spec-bar">
          <p><span>{siteData.hero.specBar.dropOffLabel}</span><strong>{rupiah(siteData.pricing.dropOff.price)}</strong></p>
          <p><span>{siteData.hero.specBar.harianLabel}</span><strong>{rupiah(siteData.pricing.harian.price)}</strong></p>
          {siteData.hero.specBar.items.map((item) => <p><span>{item.label}</span><strong>{item.value}</strong></p>)}
        </div>
      </section>

      <section class="section">
        <div class="container-lux statement reveal">
          <h2 class="display">{siteData.statement.title} <em>{siteData.statement.titleEm}</em></h2>
          <p class="lead">{siteData.statement.lead}</p>
        </div>
      </section>

      <section id="fasilitas" class="section section-alt" aria-labelledby="fasilitas-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">{siteData.facilities.badge}</p>
              <h2 id="fasilitas-title" class="display">{siteData.facilities.title} <em>{siteData.facilities.titleEm}</em></h2>
            </div>
            <p class="lead">{siteData.facilities.lead}</p>
          </div>
          <div class="pillars">
            {siteData.facilities.pillars.map((pillar) => (
              <article class="pillar reveal">
                <div class="pillar-media">
                  <img src={pillar.image} alt={pillar.alt} width="1200" height="900" loading="lazy" decoding="async" />
                </div>
                <div>
                  <span class="pillar-numeral" aria-hidden="true">{pillar.numeral}</span>
                  <p class="eyebrow mt-6">{pillar.eyebrow}</p>
                  <h3 class="display">{pillar.title}</h3>
                  <p class="lead">{pillar.lead}</p>
                  <ul>
                    {pillar.items.map((item, i) => (
                      <li><span>{String(i + 1).padStart(2, '0')}</span><div><strong>{item.name}</strong><p>{item.desc}</p></div></li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="galeri" class="section" aria-labelledby="galeri-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">{siteData.gallery.badge}</p>
              <h2 id="galeri-title" class="display">{siteData.gallery.title} <em>{siteData.gallery.titleEm}</em></h2>
            </div>
            <p class="lead">{siteData.gallery.lead}</p>
          </div>
          <MediaGallery client:visible={{ rootMargin: '600px' }} items={mediaItems} labels={siteData.gallery.labels} />
        </div>
      </section>

      <section id="harga" class="section section-alt" aria-labelledby="harga-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">{siteData.pricing.badge}</p>
              <h2 id="harga-title" class="display">{siteData.pricing.title} <em>{siteData.pricing.titleEm}</em></h2>
            </div>
            <p class="lead">{siteData.pricing.lead}</p>
          </div>

          <div class="pricing">
            <article class="price-card reveal">
              <p class="eyebrow">{siteData.pricing.dropOff.badge}</p>
              <h3 class="display">{siteData.pricing.dropOff.title}{siteData.pricing.dropOff.titleEm && <> <em>{siteData.pricing.dropOff.titleEm}</em></>}</h3>
              <p class="price">{rupiah(siteData.pricing.dropOff.price)}</p>
              <p class="price-was">{siteData.pricing.normalLabel} <s>{rupiah(siteData.pricing.dropOff.normalPrice)}</s></p>
              <ul>
                {siteData.pricing.dropOff.features.map((feature) => <li>{feature}</li>)}
              </ul>
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost">{siteData.pricing.dropOff.buttonText}</a>
            </article>

            <article class="price-card featured reveal">
              <p class="eyebrow">{siteData.pricing.harian.badge}</p>
              <h3 class="display">{siteData.pricing.harian.title} <em>{siteData.pricing.harian.titleEm}</em></h3>
              <p class="price">{rupiah(siteData.pricing.harian.price)}</p>
              <p class="price-was">{siteData.pricing.normalLabel} <s>{rupiah(siteData.pricing.harian.normalPrice)}</s></p>
              <ul>
                {siteData.pricing.harian.features.map((feature) => <li>{feature}</li>)}
              </ul>
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal">{siteData.pricing.harian.buttonText}</a>
            </article>
          </div>

          <BookingEstimator client:visible={{ rootMargin: '600px' }} />
        </div>
      </section>

      <section id="kebutuhan" class="section" aria-labelledby="kebutuhan-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">{siteData.segments.badge}</p>
              <h2 id="kebutuhan-title" class="display">{siteData.segments.title} <em>{siteData.segments.titleEm}</em></h2>
            </div>
            <p class="lead">{siteData.segments.lead}</p>
          </div>
          <ol class="segments">
            {siteData.segments.items.map((name, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p>{name}</p></li>)}
          </ol>
        </div>
      </section>

      <section class="section closing" aria-labelledby="closing-title">
        <img src={siteData.closing.image} alt="" width="1200" height="900" loading="lazy" decoding="async" />
        <div class="container-lux reveal">
          <p class="eyebrow">{siteData.closing.badge}</p>
          <h2 id="closing-title" class="display mt-6">{siteData.closing.title} <em>{siteData.closing.titleEm}</em></h2>
          <p class="lead mx-auto mt-6">{siteData.closing.lead}</p>
          <div class="mt-10 flex justify-center">
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal">{siteData.closing.buttonText} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer id="kontak" class="site-footer">
      <div class="container-lux">
        <div class="footer-grid">
          <div>
            <img src={siteData.brand.logo} alt={siteData.brand.name} width="1000" height="208" loading="lazy" class="h-9 w-auto mb-5" />
            <p class="max-w-sm">{siteData.footer.description}</p>
          </div>
          <div>
            <h4>{siteData.footer.officeLabel}</h4>
            <address class="not-italic">
              <strong>{siteData.contact.officeName}</strong><br />
              {siteData.contact.officeAddress}
            </address>
          </div>
          <div>
            <h4>{siteData.footer.serviceLabel}</h4>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="link-lux text-xl">{siteData.contact.whatsappDisplay}</a>
            <p class="mt-3">{siteData.footer.serviceNote}</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row flex-wrap justify-between gap-4 pt-8 text-xs">
          <p>{siteData.contact.copyright}</p>
          <div class="flex flex-wrap gap-6"><a href="#privasi" class="link-lux">{siteData.legal.privacyTitle}</a><a href="#ketentuan" class="link-lux">{siteData.legal.termsTitle}</a><a href="#top" class="link-lux">{siteData.footer.backToTopText}</a></div>
        </div>
        <div class="legal-notes">
          <section id="privasi"><h3>{siteData.legal.privacyTitle}</h3><p>{siteData.legal.privacyText} <a href={siteData.legal.privacyLinkUrl} target="_blank" rel="noopener noreferrer">{siteData.legal.privacyLinkText}</a>.</p></section>
          <section id="ketentuan"><h3>{siteData.legal.termsTitle}</h3><p>{siteData.legal.termsText}</p></section>
        </div>
      </div>
    </footer>

    <FloatingWhatsApp />
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      menu?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) menu.open = false;
      });
      menu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      const links = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a');
      const observer = new IntersectionObserver((entries) => {
        const current = entries.find((entry) => entry.isIntersecting);
        if (!current) return;
        for (const link of links) {
          if (link.hash === `#${current.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      }, { rootMargin: '-15% 0px -60% 0px' });
      document.querySelectorAll('main section[id], footer[id]').forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
