const waLink = 'https://wa.me/62818804288?text=Halo%20Alphard%20Elite%2C%20saya%20dapat%20kontak%20dari%20website';
const nav = [['#fasilitas', 'Fasilitas'], ['#galeri', 'Galeri'], ['#harga', 'Tarif'], ['#kebutuhan', 'Layanan'], ['#kontak', 'Kontak']];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070708" />
    <title>Sewa Alphard Bandung VIP | Alphard Elite — Five-Star Facilities</title>
    <meta name="description" content="Satu-satunya rental Alphard dengan Five-Star Facilities, First-Class Entertainment, dan Business Services di Indonesia. Drop-off Bandung mulai Rp 1.000.000, sewa harian Rp 2.500.000." />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://alphardelite.id" />
    <meta property="og:title" content="Sewa Alphard Bandung VIP | Alphard Elite" />
    <meta property="og:description" content="Luxury meets comfort and fun in every journey. Sewa Alphard Bandung dengan pengemudi profesional." />
    <meta property="og:image" content="/assets/mobil-alphard.webp" />
    <meta property="og:type" content="website" />
    <link rel="preload" as="image" href="/assets/mobil-alphard.webp" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/cormorant-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/outfit-var.woff2" crossorigin />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "AutoRental",
        "name": "Alphard Elite Bandung",
        "description": "Sewa Alphard Bandung VIP dengan Five-Star Facilities, First-Class Entertainment dan Business Services.",
        "image": "https://alphardelite.id/assets/mobil-alphard.webp",
        "telephone": "+62818804288",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "EasyBuilding 1st Floor, Jalan Cihampelas No. 201A, Cipaganti, Coblong",
          "addressLocality": "Bandung",
          "addressRegion": "Jawa Barat",
          "postalCode": "40131",
          "addressCountry": "ID"
        },
        "priceRange": "Rp 1.000.000 - Rp 2.500.000"
      }
    </script>
  </head>

  <body id="top">
    <a href="#main" class="skip-link">Langsung ke konten</a>

    <header class="site-header">
      <div class="container-lux bar">
        <a href="#top" aria-label="Alphard Elite — kembali ke atas">
          <img src="/assets/logo.webp" alt="Alphard Elite" width="1000" height="208" class="h-8 sm:h-9 w-auto" />
        </a>
        <nav aria-label="Navigasi utama" class="hidden lg:flex items-center gap-9">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <div class="flex items-center gap-4">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost hidden sm:inline-flex !min-h-11 !py-2">Reservasi</a>
          <details class="mobile-nav lg:hidden">
            <summary>Menu</summary>
            <nav aria-label="Navigasi mobile">
              {nav.map(([href, label]) => <a href={href}>{label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container-lux hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Sewa Alphard Bandung VIP</p>
            <h1 id="hero-title" class="display">Luxury meets comfort <em>&amp; fun in every journey.</em></h1>
            <p class="lead">Satu-satunya rental Alphard di Indonesia dengan <strong>Five-Star Facilities</strong>, <strong>First-Class Entertainment</strong>, dan <strong>Business Services</strong>.</p>
            <div class="hero-actions">
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal">Booking sekarang <span aria-hidden="true">↗</span></a>
              <a href="#harga" class="link-lux">Lihat tarif</a>
            </div>
          </div>
          <figure class="hero-visual">
            <span class="hero-wordmark" aria-hidden="true">ALPHARD</span>
            <img src="/assets/mobil-alphard.webp" alt="Toyota Alphard Transformer Facelift hitam milik Alphard Elite" width="1600" height="847" fetchpriority="high" decoding="async" />
            <figcaption><span>Toyota Alphard Transformer Facelift</span><span>Bebas asap rokok</span></figcaption>
          </figure>
        </div>
        <div class="container-lux spec-bar">
          <p><span>Drop-off dalam kota</span><strong>Rp 1.000.000</strong></p>
          <p><span>Sewa harian · 24 jam</span><strong>Rp 2.500.000</strong></p>
          <p><span>All in</span><strong>Driver, BBM, tol &amp; parkir</strong></p>
          <p><span>Layanan</span><strong>Dengan pengemudi</strong></p>
        </div>
      </section>

      <section class="section">
        <div class="container-lux statement reveal">
          <h2 class="display">Apakah Anda mencari pengalaman sewa Alphard yang <em>berbeda dari biasanya?</em></h2>
          <p class="lead">Di Alphard Elite, kami menghadirkan kombinasi Five-Star Facilities untuk kenyamanan luar biasa, First-Class Entertainment untuk hiburan eksklusif di setiap momen, dan Business Services untuk produktivitas sepanjang perjalanan.</p>
        </div>
      </section>

      <section id="fasilitas" class="section section-alt" aria-labelledby="fasilitas-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">Mengapa Alphard Elite</p>
              <h2 id="fasilitas-title" class="display">Tiga alasan, <em>satu perjalanan.</em></h2>
            </div>
            <p class="lead">Setiap detail kabin disiapkan untuk beristirahat, menikmati hiburan, atau menyelesaikan pekerjaan.</p>
          </div>
          <div class="pillars">
            {pillars.map((pillar) => (
              <article class="pillar reveal">
                <div class="pillar-media">
                  <img src={pillar.image} alt={pillar.alt} width="1200" height="900" loading="lazy" decoding="async" />
                </div>
                <div>
                  <span class="pillar-numeral" aria-hidden="true">{pillar.numeral}</span>
                  <p class="eyebrow mt-6">{pillar.eyebrow}</p>
                  <h3 class="display">{pillar.title}</h3>
                  <p class="lead">{pillar.lead}</p>
                  <ul>
                    {pillar.items.map(([name, desc], i) => (
                      <li><span>{String(i + 1).padStart(2, '0')}</span><div><strong>{name}</strong><p>{desc}</p></div></li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="galeri" class="section" aria-labelledby="galeri-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">Galeri foto &amp; video</p>
              <h2 id="galeri-title" class="display">Lihat lebih <em>dekat.</em></h2>
            </div>
            <p class="lead">Pilih foto atau video untuk melihat detail kabin Alphard Elite.</p>
          </div>
          <MediaGallery client:visible={{ rootMargin: '600px' }} items={mediaItems} />
        </div>
      </section>

      <section id="harga" class="section section-alt" aria-labelledby="harga-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">Tarif dalam kota Bandung</p>
              <h2 id="harga-title" class="display">Pilih cara Anda <em>bepergian.</em></h2>
            </div>
            <p class="lead">Semua paket all in dengan pengemudi profesional. Tidak tersedia lepas kunci. Untuk tujuan luar kota Bandung, hubungi Customer Service kami.</p>
          </div>

          <div class="pricing">
            <article class="price-card reveal">
              <p class="eyebrow">Sewa drop-off</p>
              <h3 class="display">Antar satu tujuan.</h3>
              <p class="price">Rp 1.000.000</p>
              <p class="price-was">Normal <s>Rp 2.000.000</s></p>
              <ul>
                <li>Profesional driver &amp; makan driver</li>
                <li>BBM, parkir &amp; tol</li>
                <li>1 titik jemput dan 1 titik antar</li>
                <li>Waktu tunggu maksimal 60 menit</li>
              </ul>
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-ghost">Booking drop-off</a>
            </article>

            <article class="price-card featured reveal">
              <p class="eyebrow">Sewa harian</p>
              <h3 class="display">Seharian, <em>tanpa batas titik.</em></h3>
              <p class="price">Rp 2.500.000</p>
              <p class="price-was">Normal <s>Rp 3.500.000</s></p>
              <ul>
                <li>Profesional driver &amp; makan driver</li>
                <li>BBM, parkir &amp; tol</li>
                <li>Titik jemput &amp; antar tidak dibatasi</li>
                <li>Durasi sewa 24 jam (00.00–23.59)</li>
              </ul>
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal">Booking harian</a>
            </article>
          </div>

          <BookingEstimator client:visible={{ rootMargin: '600px' }} />
        </div>
      </section>

      <section id="kebutuhan" class="section" aria-labelledby="kebutuhan-title">
        <div class="container-lux">
          <div class="section-head">
            <div>
              <p class="eyebrow">Kebutuhan perjalanan</p>
              <h2 id="kebutuhan-title" class="display">Kami melayani <em>setiap agenda.</em></h2>
            </div>
            <p class="lead">Apa pun kebutuhan perjalanan Anda, Alphard Elite siap memberikan pengalaman terbaik di setiap perjalanan — dan masih banyak lagi.</p>
          </div>
          <ol class="segments">
            {segments.map((name, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p>{name}</p></li>)}
          </ol>
        </div>
      </section>

      <section class="section closing" aria-labelledby="closing-title">
        <img src="/assets/foto/captain-seat-with-legrest.webp" alt="" width="1200" height="900" loading="lazy" decoding="async" />
        <div class="container-lux reveal">
          <p class="eyebrow">Reservasi</p>
          <h2 id="closing-title" class="display mt-6">Siap merasakan <em>perjalanan mewah?</em></h2>
          <p class="lead mx-auto mt-6">Jadikan setiap perjalanan bersama Alphard Elite sebagai momen istimewa. Nikmati kemewahan, kenyamanan, dan hiburan eksklusif — pesan sekarang dan rasakan perbedaannya.</p>
          <div class="mt-10 flex justify-center">
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-metal">Booking via WhatsApp <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer id="kontak" class="site-footer">
      <div class="container-lux">
        <div class="footer-grid">
          <div>
            <img src="/assets/logo.webp" alt="Alphard Elite" width="1000" height="208" loading="lazy" class="h-9 w-auto mb-5" />
            <p class="max-w-sm">Satu-satunya rental Alphard dengan Five-Star Facilities, First-Class Entertainment dan Business Services di Indonesia.</p>
          </div>
          <div>
            <h4>Office</h4>
            <address class="not-italic">
              <strong>CV Elite Vision Internasional</strong><br />
              EasyBuilding 1st Floor, Jalan Cihampelas No. 201A, Kel. Cipaganti, Kec. Coblong, Kota Bandung, Jawa Barat 40131
            </address>
          </div>
          <div>
            <h4>Customer service</h4>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="link-lux text-xl">0818 804 288</a>
            <p class="mt-3">Reservasi, jadwal, dan perjalanan luar kota melalui WhatsApp.</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row flex-wrap justify-between gap-4 pt-8 text-xs">
          <p>© 2025 Alphard Elite · Member of HANADI CORP</p>
          <div class="flex flex-wrap gap-6"><a href="#privasi" class="link-lux">Privasi</a><a href="#ketentuan" class="link-lux">Ketentuan reservasi</a><a href="#top" class="link-lux">Kembali ke atas ↑</a></div>
        </div>
        <div class="legal-notes">
          <section id="privasi"><h3>Privasi</h3><p>Formulir ini menyusun pesan di perangkat Anda. Data perjalanan tidak dikirim ke server website; pesan diteruskan ke WhatsApp saat Anda memilih untuk mengirimnya. Jangan sertakan data sensitif. Penggunaan WhatsApp mengikuti <a href="https://www.whatsapp.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">kebijakan privasi WhatsApp</a>.</p></section>
          <section id="ketentuan"><h3>Ketentuan reservasi</h3><p>Harga yang ditampilkan adalah harga untuk perjalanan dalam kota Bandung. Estimasi bukan konfirmasi pemesanan. Ketersediaan unit, rute, biaya tambahan, pembayaran, dan pembatalan dikonfirmasi oleh Customer Service sebelum pemesanan. Seluruh layanan dengan pengemudi, tidak tersedia lepas kunci.</p></section>
        </div>
      </div>
    </footer>

    <FloatingWhatsApp />

    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      menu?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) menu.open = false;
      });
      menu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      const links = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a');
      const observer = new IntersectionObserver((entries) => {
        const current = entries.find((entry) => entry.isIntersecting);
        if (!current) return;
        for (const link of links) {
          if (link.hash === `#${current.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      }, { rootMargin: '-15% 0px -60% 0px' });
      document.querySelectorAll('main section[id], footer[id]').forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
